# Copiar a apps/api/.env
DATABASE_URL=postgresql://aylluu:aylluu@127.0.0.1:5433/aylluu
REDIS_URL=redis://localhost:6379
JWT_SECRET=cambia-este-jwt-secret-largo
JWT_REFRESH_SECRET=cambia-este-refresh-secret-largo
# 32 bytes en hex (64 chars) para AES-256-GCM
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PORT=3001
WEB_ORIGIN=http://localhost:3000,http://localhost:3005
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Panel (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001
