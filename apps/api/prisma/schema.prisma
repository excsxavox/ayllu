generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum MembershipRole {
  COMPANY_ADMIN
  AGENT
}

enum WhatsAppProvider {
  META
  EVOLUTION
  TWILIO
}

enum DiscountType {
  PERCENT
  FIXED
  BOGO
}

enum RuleType {
  HOURS
  GREETING
  HANDOVER
  KEYWORD
  PROMOTION
  FALLBACK
  TAG_CONTACT
}

enum ConversationStatus {
  BOT
  HUMAN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum KnowledgeSource {
  FAQ
  MANUAL
  CATALOG
}

enum ReplyMode {
  AUTO
  HYBRID
  MANUAL
}

enum AlertType {
  NEW_CONVERSATION
  HUMAN_TAKEOVER
  BOT_FALLBACK
  OUTSIDE_HOURS
  NEEDS_REPLY
  PAYMENT_PROOF
}

enum BookingMode {
  SERVICES
  PRODUCTS
  BOTH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum BookingSource {
  PANEL
  BOT
  MANUAL
}

enum BookingPaymentStatus {
  PENDING
  DEPOSIT
  PAID
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  WEB
  TELEGRAM
}

enum ContactAudience {
  CLIENT
  CONTACT
}

enum CrmStage {
  NEW
  TALKING
  INTERESTED
  RESERVED
  WON
  LOST
}

enum CrmSource {
  WHATSAPP
  MANUAL
  WALKIN
  OTHER
}

enum CrmActivityType {
  NOTE
  STAGE
  FOLLOW
}

enum PaymentMethodType {
  TRANSFER
  CARD
}

model Company {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  timezone         String    @default("America/Lima")
  botSystemPrompt  String?
  botTone          String?
  replyMode        ReplyMode @default(AUTO)
  setupCompleted   Boolean   @default(false)
  bookingsEnabled  Boolean   @default(false)
  mapUrl           String?
  llmApiKeyEnc     String?
  llmBaseUrl       String?
  chatModel        String?
  embeddingModel   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships       Membership[]
  whatsappAccounts  WhatsAppAccount[]
  categories        Category[]
  products          Product[]
  services          Service[]
  prices            Price[]
  tags              Tag[]
  promotions        Promotion[]
  rules             BusinessRule[]
  contacts          Contact[]
  crmActivities     CrmActivity[]
  conversations     Conversation[]
  documents         KnowledgeDocument[]
  chunks            KnowledgeChunk[]
  auditLogs         AuditLog[]
  alertSettings     AlertSetting[]
  alerts            Alert[]
  cannedReplies     CannedReply[]
  bookingSettings   BookingSettings?
  bookings          Booking[]
  flows             BotFlow[]
  channels          Channel[]
  paymentMethods    PaymentMethod[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships   Membership[]
  auditLogs     AuditLog[]
  crmActivities CrmActivity[]
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  companyId String
  role      MembershipRole
  createdAt DateTime       @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model WhatsAppAccount {
  id                String           @id @default(cuid())
  companyId         String
  provider          WhatsAppProvider @default(META)
  phoneNumberId     String
  wabaId            String?
  displayPhone      String?
  accessTokenEnc    String?
  verifyTokenEnc    String?
  appSecretEnc      String?
  isActive          Boolean          @default(true)
  channelId         String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel       Channel?       @relation(fields: [channelId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@unique([provider, phoneNumberId])
  @@index([companyId])
}

model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
  services Service[]

  @@unique([companyId, name])
}

model Product {
  id              String   @id @default(cuid())
  companyId       String
  categoryId      String?
  parentServiceId String?
  name            String
  description     String?
  sku             String?
  imageUrls       String[] @default([])
  links           Json     @default("[]")
  isActive        Boolean  @default(true)
  isAddon         Boolean  @default(false)
  stock           Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parentService Service?        @relation("ServiceAddOns", fields: [parentServiceId], references: [id], onDelete: SetNull)
  prices        Price[]
  tags          ProductTag[]
  promotions    PromotionItem[]
  bookings      Booking[]

  @@index([companyId])
  @@index([parentServiceId])
}

model Service {
  id               String   @id @default(cuid())
  companyId        String
  categoryId       String?
  name             String
  description      String?
  durationMinutes  Int?
  imageUrls        String[] @default([])
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  prices     Price[]
  tags       ServiceTag[]
  promotions PromotionItem[]
  bookings   Booking[]
  addOns     Product[]       @relation("ServiceAddOns")

  @@index([companyId])
}

model Price {
  id        String   @id @default(cuid())
  companyId String
  productId String?
  serviceId String?
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("USD")
  label     String   @default("regular")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([productId])
  @@index([serviceId])
}

model Tag {
  id        String   @id @default(cuid())
  companyId String
  name      String
  color     String?
  createdAt DateTime @default(now())

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products ProductTag[]
  services ServiceTag[]
  contacts ContactTag[]

  @@unique([companyId, name])
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ServiceTag {
  serviceId String
  tagId     String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serviceId, tagId])
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model Promotion {
  id            String       @id @default(cuid())
  companyId     String
  name          String
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  code          String?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean      @default(true)
  imageUrls     String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PromotionItem[]

  @@index([companyId])
}

model PromotionItem {
  id          String  @id @default(cuid())
  promotionId String
  productId   String?
  serviceId   String?

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model BotFlow {
  id           String    @id @default(cuid())
  companyId    String
  name         String
  description  String?
  isDefault    Boolean   @default(false)
  systemPrompt String?
  tone         String?
  replyMode    ReplyMode @default(AUTO)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channels Channel[]
  rules    BusinessRule[]

  @@index([companyId])
}

model Channel {
  id        String      @id @default(cuid())
  companyId String
  type      ChannelType
  name      String
  handle    String?
  isActive  Boolean     @default(true)
  flowId    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flow            BotFlow?         @relation(fields: [flowId], references: [id], onDelete: SetNull)
  conversations   Conversation[]
  whatsappAccount WhatsAppAccount?

  @@index([companyId, type])
}

model BusinessRule {
  id          String   @id @default(cuid())
  companyId   String
  flowId      String?
  name        String
  type        RuleType
  priority    Int      @default(100)
  enabled     Boolean  @default(true)
  conditions  Json     @default("{}")
  actions     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flow    BotFlow? @relation(fields: [flowId], references: [id], onDelete: SetNull)

  @@index([companyId, enabled, priority])
}

model Contact {
  id            String          @id @default(cuid())
  companyId     String
  phone         String
  waId          String?
  name          String?
  email         String?
  audience      ContactAudience @default(CLIENT)
  stage         CrmStage        @default(NEW)
  source        CrmSource       @default(MANUAL)
  notes         String?
  expectedValue Decimal?        @db.Decimal(12, 2)
  nextActionAt  DateTime?
  nextAction    String?
  lostReason    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  tags          ContactTag[]
  bookings      Booking[]
  activities    CrmActivity[]

  @@unique([companyId, phone])
  @@index([companyId, stage])
  @@index([companyId, nextActionAt])
}

model CrmActivity {
  id        String          @id @default(cuid())
  companyId String
  contactId String
  userId    String?
  type      CrmActivityType @default(NOTE)
  body      String
  createdAt DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([companyId, createdAt])
}

model Conversation {
  id                 String             @id @default(cuid())
  companyId          String
  contactId          String
  channelId          String?
  whatsappAccountId  String?
  status             ConversationStatus @default(BOT)
  humanTakeover      Boolean            @default(false)
  lastMessageAt      DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact         Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel         Channel?         @relation(fields: [channelId], references: [id], onDelete: SetNull)
  whatsappAccount WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([companyId, lastMessageAt])
  @@index([channelId, lastMessageAt])
  @@unique([channelId, contactId])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  direction         MessageDirection
  type              String           @default("text")
  content           String
  providerMessageId String?
  rawPayload        Json?
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model KnowledgeDocument {
  id         String          @id @default(cuid())
  companyId  String
  title      String
  content    String
  sourceType KnowledgeSource @default(FAQ)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chunks  KnowledgeChunk[]

  @@index([companyId])
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  companyId  String
  documentId String
  content    String
  embedding  Unsupported("vector(1536)")?
  metadata   Json                         @default("{}")
  createdAt  DateTime                     @default(now())

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  payload   Json?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model AlertSetting {
  id        String    @id @default(cuid())
  companyId String
  type      AlertType
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
}

model Alert {
  id             String    @id @default(cuid())
  companyId      String
  type           AlertType
  title          String
  body           String
  conversationId String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, readAt, createdAt])
}

model BookingSettings {
  id                   String      @id @default(cuid())
  companyId            String      @unique
  title                String      @default("Reservas")
  mode                 BookingMode @default(SERVICES)
  slotMinutes          Int         @default(30)
  bufferMinutes        Int         @default(0)
  maxPerSlot           Int         @default(1)
  maxPerDay            Int         @default(8)
  horizonDays          Int         @default(14)
  weeklyHours          Json        @default("{}")
  customFields         Json        @default("[]")
  places               Json        @default("[]")
  /** Días YYYY-MM-DD cerrados a visitas / reservas (web, bot y móvil). */
  closedDates          String[]    @default([])
  confirmationMessage  String?
  cancelPolicy         String?
  bookableServiceIds   String[]    @default([])
  bookableProductIds   String[]    @default([])
  requirePhone         Boolean     @default(true)
  requireEmail         Boolean     @default(false)
  autoConfirm          Boolean     @default(false)
  allowBotBooking      Boolean     @default(true)
  depositPercent       Int         @default(50)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String        @id @default(cuid())
  companyId      String
  contactId      String?
  productId      String?
  serviceId      String?
  customerName   String
  customerPhone  String
  customerEmail  String?
  notes          String?
  answers        Json          @default("{}")
  startsAt       DateTime
  endsAt         DateTime
  status         BookingStatus        @default(PENDING)
  paymentStatus  BookingPaymentStatus @default(PENDING)
  source         BookingSource        @default(PANEL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([companyId, startsAt])
  @@index([companyId, status])
}

model CannedReply {
  id        String   @id @default(cuid())
  companyId String
  title     String
  body      String
  shortcut  String?
  keywords  String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model PaymentMethod {
  id            String            @id @default(cuid())
  companyId     String
  type          PaymentMethodType
  name          String
  isActive      Boolean           @default(false)
  bank          String?
  accountType   String?
  accountNumber String?
  accountHolder String?
  holderId      String?
  receiptEmail  String?
  paymentUrl    String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
}
