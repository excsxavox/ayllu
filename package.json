{
  "name": "aylluu",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @aylluu/api --filter @aylluu/web dev",
    "dev:api": "pnpm --filter @aylluu/api dev",
    "dev:web": "pnpm --filter @aylluu/web dev",
    "dev:sitio": "pnpm --filter @aylluu/sitio dev",
    "dev:movil": "pnpm --filter @aylluu/web dev:movil",
    "build": "pnpm --filter @aylluu/shared build && pnpm --filter @aylluu/api build && pnpm --filter @aylluu/web build",
    "build:movil": "pnpm --filter @aylluu/shared build && pnpm --filter @aylluu/web build:movil",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @aylluu/api prisma:migrate",
    "db:seed": "pnpm --filter @aylluu/api prisma:seed",
    "db:generate": "pnpm --filter @aylluu/api prisma:generate",
    "test": "pnpm --filter @aylluu/api test"
  }
}
